* text=auto
*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.py text eol=lf
*.svg text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf
*.png binary
*.jar binary

# Keep local-only material out of source archives too.
/tests export-ignore
/private-notes export-ignore
/docs/publishing export-ignore
/dev-tools/test-local.py export-ignore
/dev-tools/test-harvest-server.py export-ignore
/.github/workflows/regression.yml export-ignore
