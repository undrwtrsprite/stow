essedEvents(KeyboardHandler.java:2298)\n\tat knot//net.minecraft.client.KeyboardHandler.keyPress(KeyboardHandler.java:496)\n\tat knot//net.minecraft.client.KeyboardHandler.lambda$setup$1(KeyboardHandler.java:646)\n\tat knot//net.minecraft.util.thread.BlockableEventLoop.doRunTask(BlockableEventLoop.java:173)\n\tat knot//net.minecraft.util.thread.ReentrantBlockableEventLoop.doRunTask(ReentrantBlockableEventLoop.java:23)\n\tat knot//net.minecraft.util.thread.BlockableEventLoop.execute(BlockableEventLoop.java:114)\n\tat knot//net.minecraft.client.KeyboardHandler.lambda$setup$0(KeyboardHandler.java:646)\n\tat knot//org.lwjgl.glfw.GLFWKeyCallbackI.callback(GLFWKeyCallbackI.java:34)\n\tat knot//org.lwjgl.system.JNI.invokeV(Native Method)\n\tat knot//org.lwjgl.glfw.GLFW.glfwPollEvents(GLFW.java:1600)\n\tat knot//com.mojang.blaze3d.systems.RenderSystem.pollEvents(RenderSystem.java:119)\n\tat knot//net.minecraft.client.Minecraft.run(Minecraft.java:990)\n\tat knot//net.minecraft.client.main.Main.main(Main.java:248)\n\tat net.fabricmc.loader.impl.game.minecraft.MinecraftGameProvider.launch(MinecraftGameProvider.java:514)\n\tat net.fabricmc.loader.impl.launch.knot.Knot.launch(Knot.java:72)\n\tat net.fabricmc.loader.impl.launch.knot.KnotClient.main(KnotClient.java:23)\n\tat org.prismlauncher.launcher.impl.StandardLauncher.launch(StandardLauncher.java:115)\n\tat org.prismlauncher.EntryPoint.listen(EntryPoint.java:129)\n\tat org.prismlauncher.EntryPoint.main(EntryPoint.java:70)\n-\n\n#### What you expected to happen:\n\nsince its going to be a menu from outside normal mc, or a modded menu, (one example is REI (Roughly Enough Items, it modifies the normal inventory menu, and causes it to not have the .getType() function set)\nthen by default, if this error was going to happen, that menu would never be the menu type your looking for, so you should just catch it, and output it as \"an unknown menu\"\n#### Steps to reproduce:\nhow i found this:\n1. make sure you have REI + SBT\n2. open, then close your inventory (it happened in a server's world, but i dont think it matters)\n\n-note that its likely going to be a error that happens not just with REI, but with many other menus that dont have .getType() so i highly suggest you fix it generally, by catching it as a \"unknown menu\" instead of having a patch for every single one (there could be many)\n\n____\n#### Affected Versions (Do *not* use \"latest\"):\n\n- ShulkerBoxTooltip (SBT): 5.3.0-26.1.1\n- Roughly Enough Items (REI): 26.1.819\n- Minecraft: 26.1.2\n- Fabric Loader: 0.19.3\n- Fabric API: 0.155.2+26.1.2","reactions":{"url":"https://api.github.com/repos/MisterPeModder/ShulkerBoxTooltip/issues/260/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/MisterPeModder/ShulkerBoxTooltip/issues/260/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/MisterPeModder/ShulkerBoxTooltip/issues/259","repository_url":"https://api.github.com/repos/MisterPeModder/ShulkerBoxTooltip","labels_url":"https://api.github.com/repos/MisterPeModder/ShulkerBoxTooltip/issues/259/labels{/name}","comments_url":"https://api.github.com/repos/MisterPeModder/ShulkerBoxTooltip/issues/259/comments","events_url":"https://api.github.com/repos/MisterPeModder/ShulkerBoxTooltip/issues/259/events","html_url":"https://github.com/MisterPeModder/ShulkerBoxTooltip/issues/259","id":5114344096,"node_id":"I_kwDOCjBeJM8AAAABMNayoA","number":259,"title":"ender chest tooltip incorrect when having ender chest in inventory + being in the ender chest menu","user":{"login":"Tomolo-G","id":94388840,"node_id":"U_kgDOBaBCaA","avatar_url":"https://avatars.githubusercontent.com/u/94388840?v=4","gravatar_id":"","url":"https://api.github.com/users/Tomolo-G","html_url":"https://github.com/Tomolo-G","followers_url":"https://api.github.com/users/Tomolo-G/followers","follow