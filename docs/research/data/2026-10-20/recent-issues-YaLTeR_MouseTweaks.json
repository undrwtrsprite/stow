,"events_url":"https://api.github.com/repos/YaLTeR/MouseTweaks/issues/214/events","html_url":"https://github.com/YaLTeR/MouseTweaks/issues/214","id":4662778696,"node_id":"I_kwDOB4M5jM8AAAABFexbSA","number":214,"title":"Is player slot check is too primitive","user":{"login":"brachy84","id":45517902,"node_id":"MDQ6VXNlcjQ1NTE3OTAy","avatar_url":"https://avatars.githubusercontent.com/u/45517902?v=4","gravatar_id":"","url":"https://api.github.com/users/brachy84","html_url":"https://github.com/brachy84","followers_url":"https://api.github.com/users/brachy84/followers","following_url":"https://api.github.com/users/brachy84/following{/other_user}","gists_url":"https://api.github.com/users/brachy84/gists{/gist_id}","starred_url":"https://api.github.com/users/brachy84/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/brachy84/subscriptions","organizations_url":"https://api.github.com/users/brachy84/orgs","repos_url":"https://api.github.com/users/brachy84/repos","events_url":"https://api.github.com/users/brachy84/events{/privacy}","received_events_url":"https://api.github.com/users/brachy84/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":10,"created_at":"2026-06-15T07:00:07Z","updated_at":"2026-06-25T21:02:57Z","closed_at":null,"assignee":null,"author_association":"NONE","active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Im currently using the 1.20.1 version, but this is still a thing on master.\nYou check if a slot is a player slot using `selectedSlot.container == mc.player.getInventory();` in `findPullSlot()` and `findPushSlot()`. \nHowever in my UI lib https://github.com/brachy84/ModularUI-Modern slots are always a SlotItemHandler and the container field is an empty placeholder container. The check should instead look something like this\n```java\npublic boolean isPlayerSlot(Slot slot) {\n    if (slot instanceof SlotItemHandler slotItemHandler) {\n        return slotItemHandler.getItemHandler() instanceof PlayerInvWrapper || \n                slotItemHandler.getItemHandler() instanceof PlayerMainInvWrapper;\n    }\n    return slot.container instanceof Inventory;\n}\n```","reactions":{"url":"https://api.github.com/repos/YaLTeR/MouseTweaks/issues/214/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/YaLTeR/MouseTweaks/issues/214/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0}],"search_type":"lexical"}